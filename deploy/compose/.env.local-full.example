# Local Full Environment (with observability)
# Copy this file and edit values for your environment

# Load from .env.example
AI_API_ADDR=:8000
AI_DB_HOST=ai-sdlc-factory-postgres
AI_DB_PORT=5432
AI_DB_NAME=ai_sdlc_factory
AI_DB_USER=ai_sdlc_factory
AI_DB_PASSWORD=ai_sdlc_full_password
AI_JWT_SECRET=ai_sdlc_full_jwt_secret_67890
AI_MINIO_ENDPOINT=ai-sdlc-factory-minio:9000
AI_MINIO_ACCESS_KEY=minioadmin
AI_MINIO_SECRET_KEY=minioadmin
AI_NATS_URL=nats://ai-sdlc-factory-nats:4222
AI_VAULT_ADDR=http://ai-sdlc-factory-vault:8200
AI_VAULT_TOKEN=root-full-token
AI_TEMPORAL_HOST=ai-sdlc-factory-temporal:7233
AI_OTEL_ENDPOINT=ai-sdlc-factory-otel-collector:4317
AI_ANTHROPIC_API_KEY=
AI_OPENAI_API_KEY=
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Observability
LANGFUSE_HOST=ai-sdlc-factory-langfuse-web
LANGFUSE_PORT=3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
PROMETHEUS_HOST=ai-sdlc-factory-prometheus
GRAFANA_HOST=ai-sdlc-factory-grafana
