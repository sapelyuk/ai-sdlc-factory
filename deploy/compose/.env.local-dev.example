# Local Dev Environment
# Copy this file and edit values for your environment

# Load from .env.example
AI_API_ADDR=:8000
AI_DB_HOST=ai-sdlc-factory-postgres
AI_DB_PORT=5432
POSTGRES_DB=ai_sdlc_factory
POSTGRES_USER=ai_sdlc_factory
POSTGRES_PASSWORD=ai_sdlc_dev_password
AI_JWT_SECRET=ai_sdlc_dev_jwt_secret_12345
JWT_SECRET=ai_sdlc_dev_jwt_secret_12345
ALLOW_LEGACY_AUTH=true
DEPLOYMENT_PROFILE=local-dev
AI_MINIO_ENDPOINT=silo:9000
# Silo (S3-совместимое хранилище, форк MinIO)
# Образ: docker.io/pgsty/silo:<RELEASE-tag>
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AI_NATS_URL=nats://ai-sdlc-factory-nats:4222
AI_VAULT_ADDR=http://ai-sdlc-factory-vault:8200
AI_VAULT_TOKEN=root-dev-token
AI_TEMPORAL_HOST=ai-sdlc-factory-temporal:7233
AI_OTEL_ENDPOINT=ai-sdlc-factory-otel-collector:4317
AI_ANTHROPIC_API_KEY=
AI_OPENAI_API_KEY=
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Infrastructure service ports (override defaults)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NATS_PORT=4222
NATS_MONITOR_PORT=8222
VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN=root
OPA_PORT=8181

# Temporal
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080

# OTel Collector
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8888
OTEL_HEALTH_PORT=13133

# Jaeger
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC=14317
JAEGER_OTLP_HTTP=14318
JAEGER_ADMIN_PORT=14269
JAEGER_MAX_TRACES=10000
