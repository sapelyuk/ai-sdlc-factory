# Platform API
AI_API_ADDR=:8000
AI_DB_HOST=ai-sdlc-factory-postgres
AI_DB_PORT=5432
# Standard PostgreSQL variables (official Docker image convention).
# Used by the postgres service; api/worker DSN is assembled from these in docker-compose.yml.
POSTGRES_DB=ai_sdlc_factory
POSTGRES_USER=ai_sdlc_factory
POSTGRES_PASSWORD=change_me
AI_JWT_SECRET=change_me_to_random_string
AI_MINIO_ENDPOINT=ai-sdlc-factory-minio:9000
AI_MINIO_ACCESS_KEY=minioadmin
AI_MINIO_SECRET_KEY=minioadmin
AI_NATS_URL=nats://ai-sdlc-factory-nats:4222
AI_VAULT_ADDR=http://ai-sdlc-factory-vault:8200
AI_VAULT_TOKEN=change_me
AI_TEMPORAL_HOST=ai-sdlc-factory-temporal:7233
AI_OTEL_ENDPOINT=ai-sdlc-factory-otel-collector:4317

# LLM Providers
AI_ANTHROPIC_API_KEY=
AI_OPENAI_API_KEY=
AI_OLLAMA_BASE_URL=http://ai-sdlc-factory-ollama:11434

# GitHub (for integrations)
AI_GITHUB_APP_ID=
AI_GITHUB_APP_PRIVATE_KEY=
AI_GITHUB_CLIENT_ID=
AI_GITHUB_CLIENT_SECRET=

# Infrastructure service ports (override defaults)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NATS_PORT=4222
NATS_MONITOR_PORT=8222
VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN=root
OPA_PORT=8181
