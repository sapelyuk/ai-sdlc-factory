# Platform API
AI_API_ADDR=:8000
AI_DB_HOST=ai-sdlc-factory-postgres
AI_DB_PORT=5432
# Standard PostgreSQL variables (official Docker image convention).
# Used by the postgres service; api/worker DSN is assembled from these in docker-compose.yml.
POSTGRES_DB=ai_sdlc_factory
POSTGRES_USER=ai_sdlc_factory
POSTGRES_PASSWORD=change_me
AI_JWT_SECRET=change_me_to_random_string
JWT_SECRET=change-me-in-production
ALLOW_LEGACY_AUTH=false
DEPLOYMENT_PROFILE=prod
AI_MINIO_ENDPOINT=silo:9000
# Silo (S3-compatible storage, MinIO fork)
# Image: docker.io/pgsty/silo:<RELEASE-tag>
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AI_NATS_URL=nats://ai-sdlc-factory-nats:4222
AI_VAULT_ADDR=http://ai-sdlc-factory-vault:8200
AI_VAULT_TOKEN=change_me
AI_TEMPORAL_HOST=ai-sdlc-factory-temporal:7233
AI_OTEL_ENDPOINT=ai-sdlc-factory-otel-collector:4317

# LLM Providers
AI_ANTHROPIC_API_KEY=
AI_OPENAI_API_KEY=
AI_OLLAMA_BASE_URL=http://ai-sdlc-factory-ollama:11434

# GitHub (for integrations)
AI_GITHUB_APP_ID=
AI_GITHUB_APP_PRIVATE_KEY=
AI_GITHUB_CLIENT_ID=
AI_GITHUB_CLIENT_SECRET=

# Infrastructure service ports (override defaults)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NATS_PORT=4222
NATS_MONITOR_PORT=8222
VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN=root
OPA_PORT=8181
TOOL_GATEWAY_PORT=8030
WEB_PORT=3000

# Temporal (local-dev profile)
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080

# Semantic Service: workspace for SLP v0 seed (default for local seed)
SEED_WORKSPACE_ID=00000000-0000-0000-0000-000000000001


# OTel Collector
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8888
OTEL_HEALTH_PORT=13133

# Jaeger
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC=14317
JAEGER_OTLP_HTTP=14318
JAEGER_ADMIN_PORT=14269
JAEGER_MAX_TRACES=10000

# Optional (for apps — where to send traces)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
