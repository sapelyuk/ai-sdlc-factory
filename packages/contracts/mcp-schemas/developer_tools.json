{
  "role": "software-engineer",
  "schema_version": "ai-sdlc-factory/v1",
  "tools": [
    {
      "name": "git.clone",
      "description": "Clones a repository into the sandbox workspace.",
      "input_schema": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "branch": { "type": "string" }
        },
        "required": ["url"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "path": { "type": "string" }
        }
      },
      "risk_level": "R0",
      "idempotent": false,
      "requires_approval": "never"
    },
    {
      "name": "git.branch",
      "description": "Creates a new branch in the repository.",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo": { "type": "string" },
          "branch": { "type": "string" },
          "start_point": { "type": "string" }
        },
        "required": ["repo", "branch"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "branch": { "type": "string" }
        }
      },
      "risk_level": "R1",
      "idempotent": false,
      "requires_approval": "never"
    },
    {
      "name": "git.commit",
      "description": "Commits changes to the current branch.",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo": { "type": "string" },
          "message": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["repo", "message"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "commit": { "type": "string" }
        }
      },
      "risk_level": "R1",
      "idempotent": false,
      "requires_approval": "never"
    },
    {
      "name": "git.push",
      "description": "Pushes the current branch to the remote repository.",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo": { "type": "string" },
          "remote": { "type": "string" },
          "force": { "type": "boolean" }
        },
        "required": ["repo"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "remote": { "type": "string" },
          "ref": { "type": "string" }
        }
      },
      "risk_level": "R1",
      "idempotent": false,
      "requires_approval": "never"
    },
    {
      "name": "git.open_pr",
      "description": "Opens a pull request for the current branch.",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "head": { "type": "string" },
          "base": { "type": "string" }
        },
        "required": ["repo", "title", "head", "base"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "pr_url": { "type": "string" },
          "pr_number": { "type": "integer" }
        }
      },
      "risk_level": "R1",
      "idempotent": false,
      "requires_approval": "never"
    },
    {
      "name": "git.diff",
      "description": "Shows differences between commits, branches, or the working tree.",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo": { "type": "string" },
          "target": { "type": "string" },
          "context": { "type": "integer" }
        },
        "required": ["repo"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "diff": { "type": "string" }
        }
      },
      "risk_level": "R0",
      "idempotent": true,
      "requires_approval": "never"
    },
    {
      "name": "sandbox.exec",
      "description": "Executes a command inside the agent sandbox.",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string" },
          "timeout": { "type": "integer" }
        },
        "required": ["command"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" },
          "exit_code": { "type": "integer" }
        }
      },
      "risk_level": "R1",
      "idempotent": false,
      "requires_approval": "never"
    },
    {
      "name": "fs.read",
      "description": "Reads one or more files from the sandbox filesystem.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["path"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "content": { "type": "string" },
          "path": { "type": "string" }
        }
      },
      "risk_level": "R0",
      "idempotent": true,
      "requires_approval": "never"
    },
    {
      "name": "fs.write",
      "description": "Writes content to a file in the sandbox filesystem.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" },
          "mode": { "type": "string", "enum": ["overwrite", "append"] }
        },
        "required": ["path", "content"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "path": { "type": "string" }
        }
      },
      "risk_level": "R1",
      "idempotent": false,
      "requires_approval": "never"
    },
    {
      "name": "fs.delete",
      "description": "Deletes a file or directory from the sandbox filesystem.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "recursive": { "type": "boolean" }
        },
        "required": ["path"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "path": { "type": "string" }
        }
      },
      "risk_level": "R1",
      "idempotent": false,
      "requires_approval": "never"
    },
    {
      "name": "lsp.diagnostics",
      "description": "Requests diagnostics (errors, warnings) from the LSP server for a file.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] }
        },
        "required": ["path"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": { "type": "string" },
                "range": { "type": "object" },
                "severity": { "type": "string" }
              }
            }
          }
        }
      },
      "risk_level": "R0",
      "idempotent": true,
      "requires_approval": "never"
    },
    {
      "name": "test.run",
      "description": "Runs unit, integration, or end-to-end tests in the sandbox.",
      "input_schema": {
        "type": "object",
        "properties": {
          "filter": { "type": "string" },
          "timeout": { "type": "integer" },
          "parallel": { "type": "boolean" }
        },
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "passed": { "type": "integer" },
          "failed": { "type": "integer" },
          "skipped": { "type": "integer" }
        }
      },
      "risk_level": "R1",
      "idempotent": true,
      "requires_approval": "never"
    },
    {
      "name": "tracker.comment",
      "description": "Posts a comment on a tracker ticket (e.g. GitHub Issue, Jira ticket).",
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_id": { "type": "string" },
          "body": { "type": "string" }
        },
        "required": ["ticket_id", "body"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "comment_url": { "type": "string" },
          "comment_id": { "type": "string" }
        }
      },
      "risk_level": "R1",
      "idempotent": false,
      "requires_approval": "never"
    },
    {
      "name": "kb.search",
      "description": "Searches the knowledge base using hybrid (BM25 + vector) retrieval.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "limit": { "type": "integer" },
          "scope": { "type": "string", "enum": ["platform", "team", "project", "role", "task"] }
        },
        "required": ["query"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "content": { "type": "string" },
                "score": { "type": "number" }
              }
            }
          }
        }
      },
      "risk_level": "R0",
      "idempotent": true,
      "requires_approval": "never"
    },
    {
      "name": "slpr.search",
      "description": "Searches the product semantic layer (SLPr) for nodes and edges.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "kind": { "type": "string" },
          "depth": { "type": "integer" }
        },
        "required": ["query"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success", "error"] },
          "nodes": { "type": "array" },
          "edges": { "type": "array" }
        }
      },
      "risk_level": "R0",
      "idempotent": true,
      "requires_approval": "never"
    }
  ],
  "deny": ["deploy.prod", "secrets.read", "git.push_protected", "policy.change"]
}
