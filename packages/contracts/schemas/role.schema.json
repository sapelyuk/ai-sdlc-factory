{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Role Specification",
  "description": "Declarative specification for an AI agent role in the ai-sdlc-factory platform",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "system_prompt_ref", "inputs", "outputs", "tools", "model", "limits", "autonomy"],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Human-readable description of the role"
    },
    "system_prompt_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^packages/ontology/prompts/.+\\.yaml$",
      "description": "Reference to the system prompt file"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow"],
      "properties": {
        "allow": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability"],
      "properties": {
        "capability": {
          "type": "string",
          "enum": ["code-strong", "code-fast", "reasoning-strong", "reasoning-fast", "long-context", "vision-capable", "cheap-bulk", "local-private"]
        },
        "min_tokens": {
          "type": "integer",
          "minimum": 1024
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_steps", "max_cost_usd"],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "autonomy": {
      "type": "string",
      "enum": ["strict", "balanced", "autonomous"]
    },
    "quality_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
