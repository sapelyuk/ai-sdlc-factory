{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Role Specification",
  "description": "Declarative specification for an AI agent role in the ai-sdlc-factory platform",
  "oneOf": [
    {
      "$ref": "#/$defs/catalogRole"
    },
    {
      "$ref": "#/$defs/registryRoleSpec"
    }
  ],
  "$defs": {
    "catalogRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": {
          "const": "ai-sdlc-factory/v1"
        },
        "kind": {
          "const": "Role"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "description"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system_prompt_ref", "inputs", "outputs", "model", "tools", "knowledge_scopes", "limits", "autonomy"],
          "properties": {
            "system_prompt_ref": {
              "type": "string",
              "minLength": 1
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/artifact"
              }
            },
            "outputs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/artifact"
              }
            },
            "model": {
              "type": "object",
              "additionalProperties": false,
              "required": ["capability"],
              "properties": {
                "capability": {
                  "type": "string",
                  "enum": ["code-strong", "code-fast", "reasoning-strong", "reasoning-fast", "long-context", "vision-capable", "cheap-bulk", "local-private"]
                },
                "min_context": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "tools": {
              "type": "object",
              "additionalProperties": false,
              "required": ["allow", "deny"],
              "properties": {
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "deny": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "knowledge_scopes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["platform", "team", "project", "role"]
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["max_steps", "max_cost_usd", "max_wall_minutes"],
              "properties": {
                "max_steps": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_cost_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "max_wall_minutes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "autonomy": {
              "type": "string",
              "enum": ["strict", "balanced", "autonomous"]
            },
            "inputs_schema_ref": {
              "type": "string",
              "minLength": 1
            },
            "outputs_schema_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "artifact_type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Human-readable identifier, unique within the role."
        },
        "artifact_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Source of truth: SDLC_STATE_MACHINE.md §2. Free string in v1; will become an enum from SLP ArtifactType in v2 (M3, FR-SEM)."
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "Defaults to true. Set false for optional artifacts."
        },
        "schema_ref": {
          "type": "string",
          "description": "Optional path to JSON Schema. When present, handoff validation (SYSTEM_DESIGN.md §8.4, #21) uses it as expected_output_schema."
        }
      }
    },
    "registryRoleSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "system_prompt_ref", "inputs", "outputs", "tools", "model", "limits", "autonomy"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "system_prompt_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^packages/ontology/prompts/.+\\.yaml$"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow"],
          "properties": {
            "allow": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "deny": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability"],
          "properties": {
            "capability": {
              "type": "string",
              "enum": ["code-strong", "code-fast", "reasoning-strong", "reasoning-fast", "long-context", "vision-capable", "cheap-bulk", "local-private"]
            },
            "min_tokens": {
              "type": "integer",
              "minimum": 1024
            }
          }
        },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scopes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_steps", "max_cost_usd"],
          "properties": {
            "max_steps": {
              "type": "integer",
              "minimum": 1
            },
            "max_cost_usd": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "autonomy": {
          "type": "string",
          "enum": ["strict", "balanced", "autonomous"]
        },
        "quality_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
